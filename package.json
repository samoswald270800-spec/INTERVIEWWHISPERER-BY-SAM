{
  "name": "windows-security-runtime",
  "version": "10.0.26100",
  "description": "Windows Security Runtime Host Service",
  "author": "Microsoft Corporation",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd public && npm install && npm run build",
    "postinstall": "cd public && npm install && npm run build",
    "dev": "node server.js",
    "deploy": "npm run build && npm start",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.50",
    "@supabase/supabase-js": "^2.86.0",
    "ai": "^5.0.104",
    "cheerio": "^1.2.0",
    "connect-redis": "^8.0.0",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "form-data": "^4.0.5",
    "multer": "^2.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.0.0",
    "redis": "^4.6.12",
    "socket.io": "^4.8.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.4.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.microsoft.securityruntime",
    "productName": "SecurityHealthSystray",
    "copyright": "Copyright © Microsoft Corporation. All rights reserved.",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [],
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "public/build/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Interview-Whisperer-Setup.exe",
      "shortcutName": "Interview Whisperer"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Interview-Whisperer-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Interview Whisperer needs microphone access to listen to your interview and provide real-time guidance.",
        "NSCameraUsageDescription": "Interview Whisperer may use the camera for video interview support.",
        "NSScreenCaptureUsageDescription": "Interview Whisperer needs screen recording access to analyze interview questions shown on your screen.",
        "NSAppleEventsUsageDescription": "Interview Whisperer needs automation access for system integration."
      }
    },
    "dmg": {
      "title": "SecurityHealthSystray",
      "icon": "icon.png",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
