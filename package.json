{
  "name": "interview-whisperer",
  "version": "2.0.0",
  "description": "AI-powered interview companion desktop application",
  "author": "Antigravity",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd public && npm install && npm run build",
    "postinstall": "cd public && npm install && npm run build",
    "dev": "node server.js",
    "deploy": "npm run build && npm start",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.50",
    "@supabase/supabase-js": "^2.86.0",
    "ai": "^5.0.104",
    "cheerio": "^1.2.0",
    "connect-redis": "^8.0.0",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "form-data": "^4.0.5",
    "multer": "^2.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.0.0",
    "redis": "^4.6.12"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "electron": "^39.2.6",
    "electron-builder": "^26.4.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.interview.whisperer",
    "productName": "Interview Whisperer",
    "copyright": "Copyright © 2024 Antigravity",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [],
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "public/build/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Interview-Whisperer-Setup.exe"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Interview-Whisperer-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Interview Whisperer needs microphone access to listen to your interview and provide real-time guidance.",
        "NSCameraUsageDescription": "Interview Whisperer may use the camera for video interview support.",
        "NSScreenCaptureUsageDescription": "Interview Whisperer needs screen recording access to analyze interview questions shown on your screen.",
        "NSAppleEventsUsageDescription": "Interview Whisperer needs automation access for system integration."
      }
    },
    "dmg": {
      "title": "Interview Whisperer",
      "icon": "icon.png",
      "background": null,
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 130, "y": 150, "type": "file" },
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
