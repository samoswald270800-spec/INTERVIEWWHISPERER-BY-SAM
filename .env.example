# Interview Whisperer - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - OpenAI API Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# REQUIRED - Redis Configuration
# =============================================================================
# For local development, you can use a free Redis instance from:
# - Upstash: https://upstash.com/ (recommended, free tier available)
# - Redis Labs: https://redis.com/try-free/
# - Or run Redis locally: redis://localhost:6379

# Format: redis://host:port or rediss://host:port (use rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# =============================================================================
# REQUIRED - Session Security
# =============================================================================
# Generate a random string for session secret
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_here

# =============================================================================
# REQUIRED - Admin Credentials
# =============================================================================
# Set your admin username and password
ADMIN_USER=admin
ADMIN_PASS=your_secure_password_here

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================
# Port for the server (default: 3000)
PORT=3000

# Node environment (development or production)
NODE_ENV=development
